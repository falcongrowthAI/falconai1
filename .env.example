# =============================================================================
# FALCON GROWTH — Variáveis de Ambiente (Template Local / Staging / Produção)
# NUNCA comite arquivos .env reais com segredos no repositório.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Control Plane (FALCON CORE Database) ---
FALCON_CORE_DB_HOST=127.0.0.1
FALCON_CORE_DB_PORT=5432
FALCON_CORE_DB_NAME=falcon_core
FALCON_CORE_DB_USER=falcon_admin
FALCON_CORE_DB_PASSWORD=falcon_core_local_dev_password

# --- Host PostgreSQL para Provisionamento de Instâncias Individuais de Tenants ---
TENANT_PG_ADMIN_HOST=127.0.0.1
TENANT_PG_ADMIN_PORT=5432
TENANT_PG_ADMIN_USER=falcon_provisioner
TENANT_PG_ADMIN_PASSWORD=falcon_provisioner_local_dev_password

# --- Segurança, Sessão & KMS (Envelope Encryption AES-256-GCM) ---
# Chave mestra de 32 bytes em hex (64 caracteres hexadecimais) para criptografar
# senhas de bancos de tenants e tokens OAuth no FALCON CORE
FALCON_MASTER_KMS_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FALCON_JWT_SECRET=falcon_jwt_super_secret_development_key_min_32_chars

# --- Filas e Tempo Real (Redis + BullMQ + WebSockets) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Object Storage S3-Compatible (MinIO / Cloudflare R2 / AWS S3) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=falcon_minio_admin
S3_SECRET_ACCESS_KEY=falcon_minio_secret_key
S3_BUCKET_NAME=falcon-growth-storage

# --- Servidor API & Frontend ---
API_HOST=127.0.0.1
API_PORT=4000
WEB_URL=http://localhost:3000

# --- Runtime de IA (Configurado no Backend, nunca exposto ao Frontend) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
